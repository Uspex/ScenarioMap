    "curator": { "name": "куратор", "type": "cloud" },
    "support": { "name": "поддержка", "type": "messagebus" }
  },
  "rules": { "requireFile": true },
  "entrypoints": [
    { "group": "access", "kind": "doc", "name": "Регистрация", "anchor": "docs/onboarding.md::Регистрация" },
    { "group": "access", "kind": "doc", "name": "Пробный период", "anchor": "docs/onboarding.md::Пробный период" },
    { "group": "access", "kind": "doc", "name": "Окончание пробного периода", "anchor": "docs/onboarding.md::Окончание пробного периода" },
    { "group": "access", "kind": "doc", "name": "Тарифы", "anchor": "docs/billing.md::Тарифы" },
    { "group": "access", "kind": "doc", "name": "Привязка карты", "anchor": "docs/billing.md::Привязка карты" },
    { "group": "access", "kind": "doc", "name": "Списание", "anchor": "docs/billing.md::Списание" },
    { "group": "access", "kind": "doc", "name": "Отмена подписки", "anchor": "docs/billing.md::Отмена подписки" },
    { "group": "learning", "kind": "doc", "name": "Условия выдачи", "anchor": "docs/certificates.md::Условия выдачи" },
    { "group": "learning", "kind": "doc", "name": "Итоговый тест", "anchor": "docs/certificates.md::Итоговый тест" },
    { "group": "learning", "kind": "doc", "name": "Проверка проекта", "anchor": "docs/certificates.md::Проверка проекта" },
    { "group": "learning", "kind": "doc", "name": "Выдача", "anchor": "docs/certificates.md::Выдача" }
  ]
